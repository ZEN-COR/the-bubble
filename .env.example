# Copy to .env.local. Never commit real values.
# The anon key is public by design. The service role key is server-only.

# Browser and server Supabase client. Not a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC_ and do not import it into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated domains allowed to use The Bubble.
# Leave this empty until an operator confirms the real domains.
# Domain match plus a confirmed email is not identity or enrolment verification.
ALLOWED_UNIVERSITY_EMAIL_DOMAINS=

# Used later for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
